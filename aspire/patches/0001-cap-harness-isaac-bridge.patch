--- a/src/cap_harness/batch.py
+++ b/src/cap_harness/batch.py
@@ -305,10 +305,14 @@ def run_seeds(
     Results stream to ``results_jsonl`` as they land, so an interrupted sweep
     leaves the seeds it finished on disk rather than nothing at all.
     """
-    if benchmark not in {"libero-pro", "robosuite"}:
+    # yam_real is batchable only against an Isaac bridge: the simulator lives in the bridge
+    # process, so a worker only reconnects per seed. Hardware is never batched.
+    isaac = benchmark == "yam_real" and bool(os.environ.get("CAP_HARNESS_ISAAC_BRIDGE"))
+    if benchmark not in {"libero-pro", "robosuite"} and not isaac:
         raise ValueError(
-            f"run-batch does not accept {benchmark}: only libero-pro and robosuite "
-            "support worker reuse. Use a fresh `cap-harness run` process for each episode."
+            f"run-batch does not accept {benchmark}: only libero-pro, robosuite and yam_real "
+            "against an Isaac bridge support worker reuse. Use a fresh `cap-harness run` "
+            "process for each episode."
         )
     if init_mode not in {"saved", "seeded"}:
         raise ValueError("init_mode must be 'saved' or 'seeded'")
