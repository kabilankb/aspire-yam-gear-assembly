@@ -73,6 +73,25 @@ def load_asset_size(asset_folder_path: str) -> dict:
     return None
 
 
+def resting_origin_z(size_info: dict, table_z: float) -> float:
+    """Return the root Z at which an object rests on the table (plus OBJ_Z_OFFSET).
+
+    Uses the local bbox ``min.z`` from asset_size.json when present (origin not at
+    the bbox center, e.g. the factory gear assets); otherwise assumes a centered
+    origin and uses half the height.
+
+    Args:
+        size_info (dict): Parsed asset_size.json.
+        table_z (float): Table surface height (m).
+
+    Returns:
+        float: Resting root Z (m).
+    """
+    if 'min' in size_info and 'z' in size_info['min']:
+        return table_z - size_info['min']['z'] + OBJ_Z_OFFSET
+    return table_z + size_info['size']['z'] / 2.0 + OBJ_Z_OFFSET
+
+
 def get_asset_usd_path(asset_folder_path: str) -> str:
     """Return the USD file path for an asset instance folder.
 
